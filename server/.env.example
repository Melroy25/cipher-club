# Database (PostgreSQL URL: e.g. Neon, Supabase, Railway, or local PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cipher_db?schema=public"

# Authentication & Session Secrets (Generate 32+ random characters in production)
SESSION_SECRET="cipher-session-secret-change-this-in-production-random-64-chars"
JWT_SECRET="cipher-jwt-secret-change-this-in-production-random-64-chars"

# Server Configuration
PORT=4000
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"

# Cloudinary Persistent Image Storage (Optional - falls back to local /uploads if not set)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""